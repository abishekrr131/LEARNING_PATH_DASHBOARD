# Environment: development, test, production
ENV=development

# Database Configuration (PostgreSQL 16 with pgvector)
POSTGRES_USER=palp
POSTGRES_PASSWORD=palp_secret_password
POSTGRES_DB=palp
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://palp:palp_secret_password@db:5432/palp

# Redis Configuration (Celery, Rate Limiting, Caching)
REDIS_URL=redis://redis:6379/0

# Machine Learning Inference Service
ML_SERVICE_URL=http://ml:8100
MODEL_VERSION=rct-gat-1.0.0-baseline

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-for-palp-dashboard-development-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Sign-In OAuth
GOOGLE_CLIENT_ID=mock-client-id-for-development.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-client-secret-for-development
# MOCK_GOOGLE_AUTH is only permitted in development and test environments (strictly refused when ENV=production)
MOCK_GOOGLE_AUTH=true

# Google Gemini API
GEMINI_API_KEY=

# Product Parameters & Thresholds (spec §8 and §23)
THETA_SUSPECT=0.45
EPSILON_PROBE=0.10
ENTROPY_GUARD=0.70
MASTERY_TARGET=0.60
TAU_DAYS=60
COLD_START_MIN_INTERACTIONS=20

# Special Test Mode Settings (master prompt change 4)
SPECIAL_MAIN_Q_TIME_SEC=30
SPECIAL_SUB_Q_COUNT=3
SPECIAL_SUB_Q_TIME_SEC=20
SPECIAL_DEFAULT_MAIN_COUNT=5
